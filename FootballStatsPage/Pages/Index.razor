@page "/"
@using System.Net.Http.Json
@inject IConfiguration Configuration

<PageTitle>Football Stats Lookup</PageTitle>

<h1 class="mt-4">Player Statistics Lookup</h1>

<div class="row mt-3">
    <div class="col-md-6">
        <label for="playerId" class="form-label">Player ID</label>
        <input type="text" class="form-control" id="playerId" @bind="playerId" />
    </div>
    <div class="col-md-4">
        <label for="season" class="form-label">Season</label>
        <input type="text" class="form-control" id="season" @bind="season" placeholder="e.g., 2023" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-primary w-100" @onclick="FetchStats">Fetch</button>
    </div>
</div>

@if (isLoading)
{
    <div class="mt-3"><span class="spinner-border spinner-border-sm"></span> Loading...</div>
}
else if (error != null)
{
    <div class="alert alert-danger mt-3">@error</div>
}
else if (stats != null)
{
    <div class="card mt-3">
        <div class="card-body">
            <h5 class="card-title">Stats for @stats.PlayerId (@stats.Season)</h5>
            <ul class="list-group list-group-flush">
                @foreach (var prop in stats.GetType().GetProperties())
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @prop.Name.Replace('_', ' ').Replace("Id", " ID")
                        <span class="badge bg-primary rounded-pill">@prop.GetValue(stats)</span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private string playerId = "";
    private string season = "2023";
    private bool isLoading = false;
    private string? error;
    private dynamic? stats;

    private async Task FetchStats()
    {
        isLoading = true;
        error = null;
        stats = null;
        try
        {
            var baseUrl = Configuration.GetValue<string>("ApiSettings:BaseUrl") ?? "http://localhost:5000";
            using var http = new HttpClient();
            http.BaseAddress = new Uri(baseUrl);
            var response = await http.GetFromJsonAsync<dynamic>($"/api/players/{playerId}/{season}");
            stats = response;
        }
        catch (Exception ex)
        {
            error = $"Failed to fetch data: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
