@page "/"
@using ClientPlayer = global::FootballStats.Client.Player
@inject HttpClient Http
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Football Stats Dashboard</PageTitle>

<button type="button" id="themeToggleBtn" class="theme-toggle-btn" @onclick="ToggleTheme" title="Toggle Dark/Light Mode">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" style="pointer-events: none;">
        <path d="M6 .278a.768.768 0 0 1 .08.858 7.208 7.208 0 0 0-.878 3.46c0 4.021 3.278 7.277 7.318 7.277.527 0 1.04-.055 1.533-.16a.787.787 0 0 1 .81.316.733.733 0 0 1-.031.893A8.349 8.349 0 0 1 8.344 16C.734 16 0 12.286 0 7.71 0 4.266 2.114 1.312 5.124.06A.752.752 0 0 1 6 .278zM4.858 1.311A7.269 7.269 0 0 0 1.025 7.71c0 4.02 3.279 7.276 7.319 7.276a7.316 7.316 0 0 0 5.205-2.162c-.337.042-.68.063-1.029.063-4.61 0-8.343-3.714-8.343-8.29 0-1.167.242-2.278.681-3.286z"/>
        <path d="M10.794 3.148a.217.217 0 0 1 .412 0l.387 1.162c.173.513.91.513 1.083 0l.387-1.162a.217.217 0 0 1 .412 0l.387 1.162c.173.513.91.513 1.083 0l.387-1.162a.217.217 0 0 1 .412 0l-.387 1.162c.173.513-.91.513-1.083 0l-.387-1.162a.217.217 0 0 1-.412 0l-.387 1.162c.173.513-.91.513-1.083 0l-.387-1.162a.217.217 0 0 1-.412 0z"/>
    </svg>
</button>

<div class="container py-3">
    <div class="row mb-4 justify-content-center">
        <div class="col-lg-8 text-center">
            <h1 class="display-4 fw-bold mb-3" style="background: linear-gradient(90deg, var(--accent-color), #6366f1); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Football Stats Dashboard</h1>
            <p class="lead text-muted">Search for a player and season to view detailed statistics.</p>
        </div>
    </div>

    <!-- Search Section -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4 p-4 search-card">
                <div class="search-input-group row g-2 align-items-end">
                    <div class="col-md-6">
                        <label for="playerId" class="form-label fw-semibold mb-1">Player ID</label>
                        <input type="text" class="form-control rounded-3 search-input" id="playerId" placeholder="e.g., 12345" @bind="@searchPlayerId" />
                    </div>
                    <div class="col-md-6">
                        <label for="season" class="form-label fw-semibold mb-1">Season</label>
                        <select class="form-select rounded-3 search-input" id="season" @bind="@searchSeason">
                            <option value="" disabled>Select a season</option>
                            <option value="2024">2024</option>
                            <option value="2023">2023</option>
                            <option value="2022">2022</option>
                            <option value="2021">2021</option>
                            <option value="2020">2020</option>
                        </select>
                    </div>
                </div>
                <div class="mt-3 text-center search-button-wrapper">
                    <button type="button" class="btn btn-primary btn-lg px-5 fw-semibold shadow-sm" @onclick="FetchStats" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <text>Loading...</text>
                        }
                        else
                        {
                            <text>Search Stats</text>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    @if (errorMessage != null)
    {
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="alert alert-danger d-flex align-items-center rounded-3" role="alert">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                    </svg>
                    <div>@errorMessage</div>
                </div>
            </div>
        </div>
    }

    @if (playerStats != null)
    {
        <div class="row justify-content-center">
            <div class="col-12 text-center mb-4">
                <h2 class="fw-bold">@playerStats.PlayerName</h2>
                <p class="text-muted">@playerStats.League - @playerStats.LeagueCountryOfOrigin</p>
            </div>
            
            <!-- Stats Grid -->
            <div class="col-lg-8">
                <div class="row g-3">
                    @foreach (var stat in StatCards)
                    {
                        <div class="col-6 col-md-4">
                            <div class="stat-card card h-100 border-0 shadow-sm rounded-4 text-center p-3">
                                <div class="card-body">
                                    <h6 class="text-muted mb-1">@stat.Label</h6>
                                    <h3 class="fw-bold mb-0">@stat.Value</h3>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string searchPlayerId = "";
    private string searchSeason = "2023";
    private bool isLoading = false;
    private string? errorMessage = null;
    private Player.IPlayerData? playerStats = null;

    private List<(string Label, string Value)> StatCards => new()
    {
        ("Appearances", playerStats?.Appearences?.ToString() ?? "0"),
        ("Goals", playerStats?.Goals?.ToString() ?? "0"),
        ("Minutes Played", playerStats?.Minutes?.ToString() ?? "0"),
        ("Total Shots", playerStats?.TotalShots?.ToString() ?? "0"),
        ("Shots on Target", playerStats?.TotalShotsOnTarget?.ToString() ?? "0"),
        ("Pass Accuracy", $"{playerStats?.PassAccuracy}%"),
        ("Dribble Attempts", playerStats?.DribblesAttempts?.ToString() ?? "0"),
        ("Successful Dribbles", playerStats?.SuccessfulDribbles?.ToString() ?? "0"),
        ("Total Passes", playerStats?.Passes?.ToString() ?? "0")
    };

    private async Task FetchStats()
    {
        if (string.IsNullOrWhiteSpace(searchPlayerId))
        {
            errorMessage = "Please enter a Player ID.";
            return;
        }

        isLoading = true;
        errorMessage = null;
        playerStats = null;

        try
        {
            // Call the backend API endpoint directly using a relative path to avoid port/CORS mismatches
            var encodedPlayerId = Uri.EscapeDataString(searchPlayerId);
            var encodedSeason = Uri.EscapeDataString(searchSeason);
            var response = await Http.GetAsync($"/api/player?playerId={encodedPlayerId}&season={encodedSeason}");

            if (response.IsSuccessStatusCode)
            {

                playerStats = await response.Content.ReadFromJsonAsync<ClientPlayer.PlayerData>();
                if (playerStats == null)
                {
                    errorMessage = "No stats found for the given player and season.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"API Error ({response.StatusCode}): {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to fetch stats: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ToggleTheme()
    {
        Console.WriteLine("🔵 [C#] ToggleTheme clicked!");
        
        try
        {
            await JS.InvokeVoidAsync("toggleTheme");
            Console.WriteLine("🟢 [C#] JS Interop succeeded.");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"🔴 [C#] JS Interop failed: {ex.Message}");
            await JS.InvokeVoidAsync("alert", "Theme toggle failed. Check browser console for details.");
        }
    }
}
