<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <!-- Suppress duplicate assembly attributes generated during combined server/client builds -->
    <GenerateTargetFrameworkMonikerAttribute>false</GenerateTargetFrameworkMonikerAttribute>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\IntegrationToApi.csproj" />
  </ItemGroup>

  <!-- 
    Removed reference to IntegrationToApi.csproj. 
    Blazor WebAssembly projects should not directly reference server-side projects containing EF Core or heavy dependencies due to runtime pack and polyfill conflicts.
    If DTOs are required, create a shared class library project instead.
  -->

</Project>
